# Enphase Monitor Credentials
# Copy this file to credentials.yaml and fill in your actual values.
#
# credentials.yaml holds SECRETS and is gitignored — never commit it.
# Get these values from the Enphase Developer Portal:
#   https://developer-v4.enphase.com/
#
# credentials: is a LIST of one or more credential sets. Each Enphase API key is
# rate-limited to 10 requests/minute and 1000 requests/month, so listing several
# keys lets the app spread load across systems and fail over when a key is
# throttled. Each entry needs a unique `name` (names a credential for
# --update-refresh-tokens and is the token-cache key). A single entry is perfectly fine.
#
# The non-secret authorization_url and redirect_uri are shared across all
# credentials and configured once under api: in config.yaml. A credential may
# override them by adding its own authorization_url / redirect_uri here.

credentials:
  - name: enphase-monitor-01  # Unique label for this credential set
    key: "YOUR_API_KEY"  # API Key from Enphase Developer Portal
    client_id: "YOUR_CLIENT_ID"  # OAuth Client ID
    client_secret: "YOUR_CLIENT_SECRET"  # OAuth Client Secret
    refresh_token: "YOUR_REFRESH_TOKEN"  # Obtained from one-time OAuth setup (run: ./enphase-monitor --update-refresh-tokens)

  # Add more credential sets to spread the rate limit across keys. Run
  # `./enphase-monitor --update-refresh-tokens enphase-monitor-002` to obtain each one's refresh_token.
  # - name: enphase-monitor-02
  #   key: "YOUR_SECOND_API_KEY"
  #   client_id: "YOUR_SECOND_CLIENT_ID"
  #   client_secret: "YOUR_SECOND_CLIENT_SECRET"
  #   refresh_token: "YOUR_SECOND_REFRESH_TOKEN"
