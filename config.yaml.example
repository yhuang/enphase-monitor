# Enphase Monitor Configuration
# Copy this file to config.yaml and fill in your actual values.
#
# SECRETS (key, client_id, client_secret, refresh_token) live in a SEPARATE file:
# credentials.yaml. Copy credentials.yaml.example to credentials.yaml and fill it
# in. Keeping secrets out of config.yaml lets you share/commit these non-secret
# settings while the credentials file stays local (it is gitignored).

# Path to the credentials file (default: credentials.yaml).
# Override only if you keep your secrets file in a non-standard location.
credentials_file: credentials.yaml

# Your Enphase Systems
# Each system requires a system ID from Enlighten (get from Enlighten URL)

systems:
  - name: "Left Subpanel"
    id: "YOUR_SYSTEM_ID"  # Enlighten system ID (get from Enlighten URL)

  - name: "Right Subpanel"
    id: "YOUR_OTHER_SYSTEM_ID"  # Different system ID

# Refresh interval in seconds (how often to query the API)
refresh_interval: 3600  # 1 hour (recommended to stay within the API Budget)

# Timezone for reporting/display (optional)
# Examples: "US/Pacific", "America/New_York", "Europe/London"
# timezone: "US/Pacific"

# Color customization (optional - uses defaults if not specified)
# You can use either hex color codes (e.g., "#FF5733") or ANSI escape codes (e.g., "\033[38;5;208m")
# Hex codes will be automatically converted to ANSI codes. Leave empty or omit to use defaults.
# Note: reset and bold are constants defined in constants.go and cannot be customized
#colors:
#  production: "#f0b57c"            # Production - hex code
#  discharge: "#7acf38"             # Battery Discharge - hex code
#  import: "#f63cb1"                # Grid Import - hex code
#  export: "#06b6de"                # Grid Export - hex code
#  net_import_background: "#010469" # Net Flow line background highlight (import direction) 
#  net_export_background: "#7D0069" # Net Flow line background highlight (export direction)
#  net_import: "#f63cb1"            # Net Flow foreground (net import direction) - hex code
#  net_export: "#06b6de"            # Net Flow foreground (net export direction) - hex code
#  headers: "#f37320"               # Report headers, separators - hex code
#  charge: "#008600"                # Battery Charge - hex code
#  total_consumed: "#808080"        # Total Consumption - hex code
#  secondary_text: "#808080"        # Secondary info - hex code
#  primary_text: "#FFFFFF"          # Primary text - hex code
#  error: "#ff0000"                 # Error messages - hex code
